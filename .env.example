# ---- required ----
# Where the app reaches PostgreSQL. Inside docker compose this is overridden
# to point at the `db` service automatically.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- optional: TikTok live mode ----
# Without these, KLYP runs in sandbox mode (simulated uploads).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- optional: clip renderer for live uploads ----
# Live TikTok posts need a public MP4 URL: <RENDER_BASE_URL>/<clipId>.mp4
RENDER_BASE_URL=

# ---- server ----
PORT=3000
HOSTNAME=0.0.0.0

# ---- docker compose only ----
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=app_db
# APP_PORT=3000
# DB_PORT=5432
